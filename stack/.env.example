# ── Stack location (used by webhook-receiver to resolve Docker volume paths) ──
MAC_STACK_DIR=/path/to/stratum-sulcus-stack

# ── soulsync ──────────────────────────────────────────────────────────────────
SOULSYNC_API_KEY=

# ── slskd ─────────────────────────────────────────────────────────────────────
SLSKD_API_KEY=your-slskd-api-key

# ── S3-compatible storage (Garage, MinIO, R2, Backblaze B2, AWS S3, etc.) ─────
S3_ENDPOINT=https://your-s3-endpoint
S3_BUCKET=your-bucket-name
S3_REGION=auto
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ── Cloudflare ────────────────────────────────────────────────────────────────
CF_ACCOUNT=your-cloudflare-account-id
D1_DATABASE_ID=your-d1-database-id
CF_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_TUNNEL_TOKEN=

# ── Stratum Worker ────────────────────────────────────────────────────────────
STRATUM_URL=https://your-worker.workers.dev
STRATUM_USER=admin
STRATUM_PASS=your-stratum-password

# ── Metadata enrichment APIs (via soulsync) ───────────────────────────────────
LASTFM_API_KEY=
LASTFM_SECRET=
DISCOGS_TOKEN=
GENIUS_CLIENT_ID=
GENIUS_CLIENT_SECRET=
GENIUS_ACCESS_TOKEN=
ACOUSTID_API_KEY=
LISTENBRAINZ_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
